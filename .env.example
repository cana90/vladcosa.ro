# Application Configuration
VITE_SITE_NAME="Vlad Coșa - Psiholog"
VITE_DOMAIN=vladcosa.ro
VITE_EMAIL=psihologie@vladcosa.com
VITE_PHONE="+40 748 133 913"
VITE_ADDRESS="Strada August Treboniu Laurian, nr. 5, apartament 6, 300200 Timișoara, România"
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61581089522302
VITE_MAPS_EMBED_URL="https://www.google.com/maps?q=45.7465894%2C21.2190466&z=18&output=embed"

# Blog backend (Netlify Functions + Turso)
# For local development, copy this file to .env and run `netlify dev`.
# In production, set these values in the Netlify UI instead of committing .env.
TURSO_DATABASE_URL=libsql://database-name-account-name.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-database-token

# Single blog administrator account.
ADMIN_USERNAME=admin
# Generate with: npm run hash-password
# Keep the bcrypt hash in single quotes so its $ characters remain literal.
ADMIN_PASSWORD_HASH='$2b$12$INLOCUIESTE_CU_UN_HASH_BCRYPT'

# Random secret of at least 32 characters used to sign the session cookie.
SESSION_SECRET=schimba-cu-un-secret-lung-aleatoriu-de-minimum-32-caractere
