# Server
PORT=4000
NODE_ENV=development

# Fișierul SQLite și directorul imaginilor încărcate
DB_PATH=./data/blog.db
UPLOADS_DIR=./data/uploads

# Contul unic de administrare
ADMIN_USERNAME=admin
# Generează valoarea cu: npm run hash-password
ADMIN_PASSWORD_HASH=$2b$12$INLOCUIESTE_CU_UN_HASH_BCRYPT

# Secret aleatoriu de minimum 32 de caractere, folosit pentru semnarea sesiunii
SESSION_SECRET=schimba-cu-un-secret-lung-aleatoriu-de-minimum-32-caractere
